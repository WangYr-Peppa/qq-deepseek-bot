# ==========================================================================
# QQ bot configuration.
# Copy to .env, fill in the blanks, then:  chmod 600 .env
# Never commit the real .env -- it is in .gitignore for a reason.
# ==========================================================================

# --- QQ open platform (required) ------------------------------------------
# From https://q.qq.com -> your bot -> 开发设置
QQ_APPID=
QQ_APP_SECRET=
# QQ moved the official API host on 2026-08-10; the pinned SDK still defaults
# to the old one, so bot.py patches it at import time. Leave as-is unless you
# know the host changed again.
QQ_API_DOMAIN=api.bot.qq.com

# --- DeepSeek (required) --------------------------------------------------
# https://platform.deepseek.com -> API keys
DEEPSEEK_API_KEY=
# The Anthropic-compatible endpoint is used because it is the only one that
# supports the server-side web_search tool.
DEEPSEEK_ANTHROPIC_URL=https://api.deepseek.com/anthropic/v1/messages
DEEPSEEK_MODEL=deepseek-flash

# --- access control -------------------------------------------------------
# Comma separated QQ openids (NOT QQ numbers -- send /id to the bot to get it).
# In whitelist mode these are the only people the bot answers; they are also the
# only ones allowed to run admin commands (/wipe, /reset ...).
# Set this BEFORE the first start, otherwise the bot ignores everyone.
BOT_OWNER_IDS=
# 1 = whitelist mode, only BOT_OWNER_IDS get answers; 0 = anyone may @ or DM it.
BOT_PRIVATE_MODE=1

# --- replies --------------------------------------------------------------
# Visible reply length cap (chars). QQ passive replies also have a byte cap.
BOT_MAX_CHARS=1500
BOT_MAX_BYTES=4000
# max_tokens must cover thinking tokens as well, so keep it well above
# BOT_MAX_CHARS and truncate at send time instead.
BOT_MAX_TOKENS=4096
# Messages longer than BOT_MAX_CHARS are split at "|||" into up to N bubbles.
BOT_MAX_PARTS=3

# --- memory ---------------------------------------------------------------
# Q&A rounds kept in context, and idle seconds before a conversation is forgotten.
BOT_MEMORY_TURNS=10
BOT_MEMORY_TTL=1800
BOT_MEMORY_MAX_CHARS=4000
# Every message is archived on disk; the model only ever sees the window above.
BOT_DB_PATH=/opt/hub/memory.db
BOT_ARCHIVE_DAYS=180
BOT_EXPORT_DIR=/opt/hub/exports
# Prefix shown by /export, e.g. "me@example.com" for scp.
BOT_SCP_PREFIX=<user>@<host>

# --- persona --------------------------------------------------------------
# Markdown file with the system prompt. Falls back to BOT_SYSTEM_PROMPT,
# then to a short generic default. See prompt.example.md.
BOT_PROMPT_FILE=/opt/hub/prompt.md
# BOT_SYSTEM_PROMPT=

# --- optional features ----------------------------------------------------
# Server-side web search (billed by DeepSeek, only used when the model asks).
BOT_WEB_SEARCH=1
BOT_SEARCH_MAX_USES=3
# Fetch links the user pastes, so the model can read them without the body.
BOT_FETCH_PAGES=1
BOT_FETCH_MAX_PAGES=2
BOT_FETCH_MAX_BYTES=2097152
BOT_FETCH_MAX_CHARS=3500
BOT_FETCH_TIMEOUT=20
# Image understanding (multimodal model, costs more per turn).
BOT_MAX_IMAGES=3
BOT_IMAGE_MAX_BYTES=8388608

# --- logging --------------------------------------------------------------
BOT_LOG_LEVEL=INFO
# 1 = dump raw inbound payloads to the log, for debugging only.
BOT_DEBUG_PAYLOAD=0
